              "mode": "raw",
              "raw": "{\n  \"name\": \"Firulais\",\n  \"species\": \"Perro\",\n  \"breed\": \"Labrador\",\n  \"age\": 3,\n  \"owner\": \"Juan Perez\"\n}"
