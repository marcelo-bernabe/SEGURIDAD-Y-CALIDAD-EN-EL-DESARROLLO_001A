            "url": { "raw": "{{baseUrl}}/patient", "host": ["{{baseUrl}}"], "path": ["patient"] }
          }
        },
        {
          "name": "2.3 Obtener lista de todos los pacientes",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "{{token}}" } ],
            "url": { "raw": "{{baseUrl}}/patient", "host": ["{{baseUrl}}"], "path": ["patient"] }
          }
        },
        {
          "name": "2.4 Obtener paciente con ID 2",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "{{token}}" } ],
            "url": { "raw": "{{baseUrl}}/patient/{{patientId2}}", "host": ["{{baseUrl}}"], "path": ["patient", "{{patientId2}}"] }
          }
        },
        {
          "name": "2.5 Borrar 1 paciente",
          "request": {
            "method": "DELETE",
            "header": [ { "key": "Authorization", "value": "{{token}}" } ],
            "url": { "raw": "{{baseUrl}}/patient/{{patientIdToDelete}}", "host": ["{{baseUrl}}"], "path": ["patient", "{{patientIdToDelete}}"] }
          }
        }
      ]
    },
